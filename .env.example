# teamledger — OPTIONAL configuration.
#
# You do not need this file. `docker compose up -d` works with no .env at all:
# the database is a file under ./data and the session secret is generated on
# first boot. Copy this to .env only if you want to change one of the defaults.
#
#   cp .env.example .env
#   docker compose up -d

# --- App server ---
PORT=3212

# Used for every date the app renders and for deciding which day a game falls
# on when the calendar feed hands us a UTC timestamp. Set it to your team's
# local timezone or the schedule will drift by a day around midnight.
TZ=America/New_York

# Where the database, the nightly backups and uploaded receipts live. Inside
# the container this is /app/data, which the compose file maps to ./data on the
# host. There is rarely a reason to change it.
# DATA_DIR=/app/data

# A free-text label for this deployment, echoed back by /api/health. Handy if
# you run more than one instance and want to confirm which one a hostname is
# actually reaching.
BUILD_ID=local

# The URL you actually browse to, including the scheme. If this is https://,
# session cookies are issued with the Secure flag; leave it http:// when running
# directly on a LAN with no TLS in front, or the browser will discard your login.
APP_URL=http://localhost:3112

# Secure cookies switch on when this is "production", which means the browser
# will only keep a session over https. Use development if you're reaching the
# app directly over plain http (no TLS-terminating proxy in front).
NODE_ENV=production

# --- Security switches (both default OFF) ---
# Send session cookies with the Secure flag. Turn this on ONLY when you have TLS
# in front. On without TLS, the browser accepts the cookie and then refuses to
# send it back — you bounce off the login form with no error. Deliberately not
# tied to NODE_ENV for exactly that reason.
SECURE_COOKIES=false

# Believe the X-Forwarded-For header. Turn this on ONLY when a reverse proxy you
# control is setting it. On without a proxy, anyone can forge the header and give
# themselves a fresh login rate-limit bucket on every request.
TRUST_PROXY=false

# Failed logins allowed per window before the endpoint starts refusing.
LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW_MS=900000

# Signs the admin session cookie. LEAVE THIS BLANK unless you have a reason to
# manage it yourself — one is generated on first boot and stored in the
# database, which is what lets the app start with no configuration at all.
# Setting it here overrides the stored one. Switching between the two logs the
# admin out; it does not affect any stored data.
# SESSION_SECRET=

# --- Calendar sync ---
# How often to re-fetch the calendar feed, in minutes. TeamSnap, for one, can
# take up to 24h to publish schedule edits into the feed, so polling much more
# often than this buys nothing.
ICAL_SYNC_INTERVAL_MINUTES=360

# --- Backups ---
# A snapshot of the database is written to data/backups every night at 03:00
# local time, and the most recent 14 are kept. Set to "off" to disable.
# BACKUPS=off
